      "text": "PATCH /api/todos/items\n    req -> {items = [{ \n            itemId = Guid, \n            item = {  \n               Title? : string,\n               Status? : Status,\n               DueUtc? :  DateTime,\n               Priority? : int [1,4],\n               Description? : string,\n               ListId? : Guid }] \n             }\n    res ->  { items = [Item] }",
